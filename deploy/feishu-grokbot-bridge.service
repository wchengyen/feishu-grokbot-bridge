[Unit]
Description=Feishu long-connection bridge to Grok Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the same user that owns the outbox. Uncomment and set:
# User=bridge
# Group=bridge
WorkingDirectory=/opt/feishu-grokbot-bridge
EnvironmentFile=/opt/feishu-grokbot-bridge/.env
ExecStart=/opt/feishu-grokbot-bridge/.venv/bin/python -m bridge.main
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
