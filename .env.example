# 只放範例，不要把真的密鑰提交進 git。
# Copy to .env and fill in. chmod 600 .env

# 飛書企業自建應用「憑證與基礎信息」裡的 App ID / App Secret。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 允許下任務的 open_id，逗號分隔。留空會拒絕所有人（日誌會印出被拒絕的 open_id）。
FEISHU_ALLOWED_OPEN_IDS=

# 選填。設定後，群組訊息必須 @ 到這個 open_id 才受理。
# 不設定時，任何具體 @（不含單獨的 @_all）都算。只開了「群組裡 @ 機器人」權限時通常夠用。
FEISHU_BOT_OPEN_ID=

# 國際版 Lark 改成 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn

# Grok Bot routine 面板上的 POST URL 與 sender key。
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=

# Sender key 的標頭格式以 routine 面板顯示的 header 為準，這裡不要自己猜。
# 預設對應面板上常見的 `Authorization: Bearer <key>`。
# 若面板的 header 沒有 scheme，把 GROKBOT_WEBHOOK_AUTH_SCHEME 留空。
GROKBOT_WEBHOOK_AUTH_HEADER=Authorization
GROKBOT_WEBHOOK_AUTH_SCHEME=Bearer

# 與 Grok Bot 同一台機器上的 outbox。routine 會把結果寫到這裡。
BRIDGE_OUTBOX_DIR=./outbox
BRIDGE_DB_PATH=./data/bridge.db
BRIDGE_HISTORY_TURNS=10
BRIDGE_HEALTH_FILE=./data/health.json
BRIDGE_LOG_LEVEL=INFO

# 可選調校。
# BRIDGE_WEBHOOK_TIMEOUT_SECONDS=30
# BRIDGE_WEBHOOK_MAX_RETRIES=5
# BRIDGE_WEBHOOK_RETRY_BASE_SECONDS=1
# BRIDGE_WEBHOOK_RETRY_MAX_SECONDS=30
# BRIDGE_OUTBOX_POLL_SECONDS=2
# BRIDGE_OUTBOX_PARTIAL_GRACE_SECONDS=5
# BRIDGE_TEXT_SPLIT_CHARS=4000
# BRIDGE_TEXT_FILE_CHARS=12000
# BRIDGE_HEALTH_INTERVAL_SECONDS=10
# BRIDGE_HEALTH_STALE_SECONDS=30
